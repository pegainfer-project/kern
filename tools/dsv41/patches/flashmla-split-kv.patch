+#pragma once
+// Combine kernel of the split-KV fused decode (see kernel.cuh, FWD_MODE == DecodeWithSplitKV): merges the
+// `parts` partials of every (token, head) with the usual lse weights, applies the attention sink, the conjugate
+// O RoPE (last 64 dims) and the per-32 UE8M0 FP8 cast, and writes exactly the layout of the non-split epilogue:
+// out_fp8 [s_q, n_wv_group(8), d_v/32(16), wv_group_size(8), 32] and packed out_sf u32 [8][32][stride_sf_head_dim].
+// One CTA per (token, 8 heads), one warp per head; a lane holds float4 chunks at lane*4 + i*128 like the upstream
+// combine, so the RoPE pairs of dims 448..511 sit in chunk 3 of lanes 16..31 and every 32-dim quant tile spans 8 lanes.
+#include <cuda_fp8.h>
+#include <math_constants.h>
+#include <cutlass/float8.h>
+
+namespace sm100::prefill::fused_norm_rope_attn_rope_cast_fwd::core_attn {
+
+template<int MAX_PARTS>
+__global__ void __launch_bounds__(256)
+fused_split_combine_kernel(const float* __restrict__ o_accum, const float* __restrict__ lse_accum,
+                           const float* __restrict__ attn_sink, const uint32_t* __restrict__ token_positions,
+                           const float* __restrict__ cos_sin_cache, cutlass::float_e4m3_t* __restrict__ out_fp8,
+                           uint32_t* __restrict__ out_sf, int parts, int stride_o_split, int stride_o_s_q,
+                           int stride_lse_split, int stride_lse_s_q, int stride_sf_wv_group, int stride_sf_head_dim) {
+    static_assert(MAX_PARTS <= 32);
+    const int s_q_idx = blockIdx.x;
+    const int warp_idx = threadIdx.x / 32, lane_idx = threadIdx.x % 32;
+    const int head_idx = blockIdx.z * 8 + warp_idx;
+    __shared__ float scale_buf[8][MAX_PARTS];
+
+    cudaGridDependencySynchronize();
+
+    // Weights of the parts: exp2(lse_p - L), L = log2(sum 2^lse_p) merged with the sink like the non-split epilogue
+    float local_lse = lane_idx < parts ? lse_accum[lane_idx * stride_lse_split + s_q_idx * stride_lse_s_q + head_idx] : -CUDART_INF_F;
+    float max_lse = local_lse;
+    for (int offset = 16; offset >= 1; offset /= 2)
+        max_lse = max(max_lse, __shfl_xor_sync(0xffffffffu, max_lse, offset));
+    float sum_lse = max_lse == -CUDART_INF_F ? 0.0f : exp2f(local_lse - max_lse);
+    for (int offset = 16; offset >= 1; offset /= 2)
+        sum_lse += __shfl_xor_sync(0xffffffffu, sum_lse, offset);
+    float global_lse = sum_lse == 0.0f ? CUDART_INF_F : log2f(sum_lse) + max_lse;
+    if (attn_sink != nullptr) {
+        float sink = __ldg(attn_sink + head_idx) * CUDART_L2E_F;
+        if (global_lse != CUDART_INF_F) {
+            global_lse += log2f(1.0f + exp2f(sink - global_lse));
+        }
+        // No token attended: the non-split epilogue writes zeros (l == 0), keep that
+    }
+    scale_buf[warp_idx][lane_idx < MAX_PARTS ? lane_idx : 0] = exp2f(local_lse - global_lse);
+    __syncwarp();
+
+    float4 acc[4] = {{0.f, 0.f, 0.f, 0.f}, {0.f, 0.f, 0.f, 0.f}, {0.f, 0.f, 0.f, 0.f}, {0.f, 0.f, 0.f, 0.f}};
+    const float* o_base = o_accum + (uint64_t)s_q_idx * stride_o_s_q + head_idx * 512 + lane_idx * 4;
+    #pragma unroll 1
+    for (int p = 0; p < parts; ++p) {
+        float w = scale_buf[warp_idx][p];
+        if (w == 0.0f) continue;
+        const float* src = o_base + (uint64_t)p * stride_o_split;
+        #pragma unroll
+        for (int i = 0; i < 4; ++i) {
+            float4 v = *(const float4*)(src + i * 128);
+            acc[i].x += w * v.x; acc[i].y += w * v.y; acc[i].z += w * v.z; acc[i].w += w * v.w;
+        }
+    }
+
+    // Conjugate RoPE on dims 448..511 (chunk 3, lanes 16..31): pair (2m, 2m+1) rotates by angle m of the token's position
+    if (lane_idx >= 16) {
+        uint32_t position = __ldg(token_positions + s_q_idx);
+        const float* cs = cos_sin_cache + (uint64_t)position * 64 + (lane_idx - 16) * 2;
+        float c0 = __ldg(cs), c1 = __ldg(cs + 1), s0 = __ldg(cs + 32), s1 = __ldg(cs + 33);
+        float4 v = acc[3];
+        acc[3] = float4{v.x * c0 + v.y * s0, -v.x * s0 + v.y * c0, v.z * c1 + v.w * s1, -v.z * s1 + v.w * c1};
+    }
+
+    const int wv_group_idx = head_idx / 8, head_idx_in_wv_group = head_idx % 8;
+    cutlass::float_e4m3_t* out_base = out_fp8 + (uint64_t)s_q_idx * (64 * 512) + wv_group_idx * (8 * 512) + head_idx_in_wv_group * 32 + (lane_idx % 8) * 4;
+    #pragma unroll
+    for (int i = 0; i < 4; ++i) {
+        // Quant tile = 32 dims = 8 lanes; the same rounding as the fused epilogue (abs max rounded up to a power of two)
+        float amax = max(max(fabsf(acc[i].x), fabsf(acc[i].y)), max(fabsf(acc[i].z), fabsf(acc[i].w)));
+        amax = max(amax, __shfl_xor_sync(0xffffffffu, amax, 1));
+        amax = max(amax, __shfl_xor_sync(0xffffffffu, amax, 2));
+        amax = max(amax, __shfl_xor_sync(0xffffffffu, amax, 4));
+        amax = max(1e-4f, amax);
+        float sf = amax / 448.0f;
+        uint32_t sf_as_uint32 = *reinterpret_cast<uint32_t*>(&sf);
+        uint32_t exp_sf = (int32_t)((sf_as_uint32 - 1) >> 23) + (1 - 127);
+        uint32_t sf_inv_as_uint32 = (127 - exp_sf) << 23;
+        float sf_inv = *reinterpret_cast<float*>(&sf_inv_as_uint32);
+        float2 lo = {acc[i].x * sf_inv, acc[i].y * sf_inv}, hi = {acc[i].z * sf_inv, acc[i].w * sf_inv};
+        uint32_t packed = (uint32_t)__nv_cvt_float2_to_fp8x2(lo, __NV_SATFINITE, __NV_E4M3)
+                        | ((uint32_t)__nv_cvt_float2_to_fp8x2(hi, __NV_SATFINITE, __NV_E4M3) << 16);
+        int tile_idx = i * 4 + lane_idx / 8;   // dims [tile*32, tile*32+32)
+        *(uint32_t*)(out_base + tile_idx * (32 * 8)) = packed;
+        if (lane_idx % 8 == 0) {
+            int sf_block_idx = head_idx_in_wv_group + tile_idx * 8;
+            *((uint8_t*)(out_sf + s_q_idx + wv_group_idx * stride_sf_wv_group + (sf_block_idx / 4) * stride_sf_head_dim) + sf_block_idx % 4) = (uint8_t)(exp_sf + 127);
+        }
+    }
+}
+
+}
